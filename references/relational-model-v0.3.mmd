    BILLING_DOCUMENT {
        uuid billing_document_id PK
        string document_number
        string document_series
        string document_type_code
        date issue_date
        string document_currency_code
        string semantic_model_version
    }
    BILLING_LINE {
        uuid billing_line_id PK
        uuid billing_document_id FK
        uuid parent_line_id FK
        string line_number
        string line_role_code
        boolean contributes_to_document_totals
        decimal quantity_value
        string quantity_unit_code
        decimal line_net_amount
        string line_net_currency_code
        int sequence_no
    }
    PARTY { uuid party_id PK string name string legal_name string trading_name }
    DOCUMENT_PARTY { uuid document_party_id PK uuid billing_document_id FK uuid party_id FK string role_code }
    LINE_PARTY { uuid line_party_id PK uuid billing_line_id FK uuid party_id FK string role_code }
    PARTY_IDENTIFIER { uuid party_identifier_id PK uuid party_id FK string scheme_code string identifier_value }
